# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection (Local or Atlas URI)
# If local MongoDB is not running, server can fall back to an isolated in-memory MongoDB in development
MONGODB_URI=mongodb://127.0.0.1:27017/smart_campus_booking

# Security & JWT Token Secret (at least 32 characters in production)
JWT_SECRET=campus_smart_resource_booking_jwt_secret_dev_key_2026_xyz!

# Allowed Client Origin (for CORS and credentials)
CLIENT_ORIGIN=http://localhost:5173

# Development Seed Bootstrap Credentials (Only used during seeding/bootstrap)
ADMIN_SEED_EMAIL=admin@campus.edu
ADMIN_SEED_PASSWORD=AdminSecure2026!
STUDENT_SEED_PASSWORD=Student123!
